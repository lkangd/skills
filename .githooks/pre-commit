#!/bin/sh
set -eu

if git diff --cached --quiet -- package.json .claude-plugin/marketplace.json .agents/plugins/marketplace.json plugins scripts/lint-plugin-install.py .githooks; then
    exit 0
fi

snapshot=$(mktemp -d "${TMPDIR:-/tmp}/plugin-install.XXXXXX")
trap 'rm -rf "$snapshot"' EXIT
git checkout-index --all --ignore-skip-worktree-bits --prefix="$snapshot/"
lint="$snapshot/scripts/lint-plugin-install.py"
if [ ! -f "$lint" ]; then
    printf '%s\n' 'Include scripts/lint-plugin-install.py when first committing the plugin installation check.' >&2
    exit 1
fi
python3 "$lint" --root "$snapshot"
